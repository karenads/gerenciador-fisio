<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="440.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.back.TratamentoController">
   <children>
      <Label layoutX="24.0" layoutY="22.0" text="Cadastro de Tratamento" />

      <Label layoutX="60.0" layoutY="70.0" text="Nome" />
      <Label layoutX="60.0" layoutY="111.0" text="Descrição" />
      <Label layoutX="60.0" layoutY="152.0" text="Data início" />
      <Label layoutX="60.0" layoutY="193.0" text="Data final" />
      <Label layoutX="60.0" layoutY="234.0" text="Total de sessões" />
      <Label layoutX="60.0" layoutY="275.0" text="Sessões realizadas" />

      <TextField fx:id="txtNome" layoutX="190.0" layoutY="66.0" prefWidth="265.0" />
      <TextField fx:id="txtDescricao" layoutX="190.0" layoutY="107.0" prefWidth="265.0" />
      <TextField fx:id="txtDataInicio" layoutX="190.0" layoutY="148.0" prefWidth="265.0" promptText="dd/MM/yyyy HH:mm" />
      <TextField fx:id="txtDataFinal" layoutX="190.0" layoutY="189.0" prefWidth="265.0" promptText="dd/MM/yyyy HH:mm" />
      <TextField fx:id="txtTotalSessoes" layoutX="190.0" layoutY="230.0" prefWidth="265.0" />
      <TextField fx:id="txtSessoesRealizadas" layoutX="190.0" layoutY="271.0" prefWidth="265.0" />

      <Button layoutX="24.0" layoutY="392.0" mnemonicParsing="false" onAction="#voltar" text="Voltar" />
      <Button layoutX="501.0" layoutY="392.0" mnemonicParsing="false" onAction="#salvarTratamento" text="Salvar" />
   </children>
</AnchorPane>
